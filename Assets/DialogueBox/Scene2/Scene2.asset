      pitch: 1
      maxvol: 0
      loop: 0
      type: 1
      state: 0
      isPlaying: 0
    DialogueText: "So you better be conserving your fuel or you won\u2019t have enough
      by the time you need to deliver to the second planet."
  - AudioClip:
      nameClip: 3
      clip: {fileID: 8300000, guid: 68e03fb039aace84f9d315e883eb8406, type: 3}
